# Force LF on everything the Linux RDP runs. Windows checkouts would otherwise
# get CRLF, which breaks bash ("bad interpreter") and confuses Genus.
*.sh   text eol=lf
*.tcl  text eol=lf
*.sdc  text eol=lf
*.sv   text eol=lf
*.v    text eol=lf
*.py   text eol=lf
*.md   text eol=lf

# Never touch binaries or compressed reports.
*.png  binary
*.gz   binary
